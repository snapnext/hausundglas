# Resend API key for the contact form (app/api/contact/route.ts).
# Set in Vercel project settings before launch.
# Without RESEND_API_KEY the route runs in mock mode: payload is logged
# server-side and the form returns ok:true so local dev still works.
#
# Setup:
#   1. Sign up at https://resend.com and verify your sending domain.
#   2. Create an API key, paste it here, also add it to Vercel.
#   3. Set RESEND_FROM to a verified address on the verified domain.
RESEND_API_KEY=
RESEND_FROM=website@al-pflegeservice.de
